# Copy to .env and fill in. .env is gitignored - never commit real keys.
COHERE_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here

# Lightning AI (LitAI) - used for query rewriting and generation when set.
# Serves the same Gemini models without Google's 15 req/min free-tier cap.
LIGHTNING_API_KEY=sk-lit-your-key-here
